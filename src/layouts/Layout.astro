---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "STASH — The Personal Action Vault | Save it. STASH it. Actually use it.",
  description = "The internet has a Save button. STASH is what happens next. Turn saved recipes into dinner, workout reels into gym sessions, and travel clips into trip notes."
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en" class="scroll-smooth bg-[#050608] text-[#EDEDEB]">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href="https://stashreel.app/" />
  <meta name="theme-color" content="#050608" />

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://stashreel.app/" />
  <meta property="og:title" content="STASH — Save it. STASH it. Actually use it." />
  <meta property="og:description" content="The Personal Action Vault for what you find online. Transform scattered videos into structured, private tools you can actually watch and use." />
  <meta property="og:image" content="/assets/icon-512.png" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="STASH — The Personal Action Vault" />
  <meta name="twitter:description" content="The internet has a Save button. STASH is what happens next." />
  <meta name="twitter:image" content="/assets/icon-512.png" />

  <!-- Favicons -->
  <link rel="icon" type="image/png" href="/assets/icon-512.png" />
  <link rel="apple-touch-icon" href="/assets/icon-512.png" />

  <!-- Core Stylesheet with Cache Busting -->
  <link rel="stylesheet" href="/styles.css?v=2.0.4" />

  <!-- Critical Inline Base Fallback -->
  <style is:inline>
    html, body {
      background-color: #050608 !important;
      color: #EDEDEB !important;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
      margin: 0;
      padding: 0;
      -webkit-font-smoothing: antialiased;
    }
    a {
      color: inherit;
      text-decoration: none;
    }
    img {
      max-width: 100%;
      height: auto;
    }
  </style>

  <!-- Typography: Inter & Space Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,400&family=Space+Mono:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet" />

  <!-- Schema.org JSON-LD -->
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "STASH",
      "applicationCategory": "ProductivityApplication",
      "operatingSystem": "Android, iOS",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "USD"
      },
      "description": "The Personal Action Vault for the things you find online. Turn saved recipes into dinner, workout reels into gym sessions, and travel clips into trip notes."
    }
  </script>
</head>
<body class="bg-[#050608] text-[#EDEDEB] selection:bg-[#FF2D55] selection:text-white min-h-screen">
  <div class="grain-overlay"></div>
  <slot />
</body>
</html>
