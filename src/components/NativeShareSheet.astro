---
// Section 3: THE 1-TAP HABIT — Native Share Sheet Capture
---

<section id="capture" class="scroll-mt-24 py-20 md:py-28 bg-[#040507] border-b border-white/[0.06] relative">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 text-center">
    
    <!-- Section Header -->
    <div class="max-w-3xl mx-auto mb-16 space-y-4">
      <div class="inline-block telemetry-pill text-[#10B981] bg-[#10B981]/10 border-[#10B981]/30">
        THE 1-TAP HABIT
      </div>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-black text-white tracking-tight leading-tight">
        See it. Share it. STASH it.
      </h2>
      <p class="text-base sm:text-lg text-[#9CA3AF] max-w-xl mx-auto leading-relaxed">
        One tap from your phone's native Share Sheet. No links to copy. No app-hopping.
      </p>
    </div>

    <!-- 3-Step Clean Flow -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-left">
      
      <!-- Step 1 -->
      <div class="specular-box p-6 rounded-2xl flex flex-col justify-between group">
        <div class="space-y-4">
          <div class="flex items-center justify-between text-xs font-mono">
            <span class="text-[#FF2D55] font-bold">01 · SPOT IT</span>
            <span class="text-[#8E9196]">ANY APP</span>
          </div>
          
          <!-- Authentic Social Feed Preview Card -->
          <div class="w-full aspect-[16/10] rounded-xl bg-[#0B0D12] border border-white/10 overflow-hidden relative group-hover:border-white/20 transition-all">
            <img src="/assets/stash_ui_v3_potato_reel.jpg" alt="Social Post Preview" class="w-full h-full object-cover opacity-60 group-hover:scale-105 transition-transform duration-500" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/30 to-black/40"></div>
            
            <div class="absolute top-2.5 left-2.5 px-2 py-0.5 rounded-full bg-black/70 backdrop-blur-md border border-white/10 text-[9px] font-mono text-white/90 flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-[#FF2D55]"></span>
              <span>@recipeincaption · Reel</span>
            </div>

            <div class="absolute bottom-2.5 right-2.5 flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-white/20 backdrop-blur-md border border-white/40 text-[10px] font-mono text-white shadow-lg animate-pulse">
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/><polyline points="16 6 12 2 8 6"/><line x1="12" y1="2" x2="12" y2="15"/></svg>
              <span>Tap Share</span>
            </div>
            
            <div class="absolute bottom-2.5 left-2.5 text-[10px] font-mono text-white/70">
              Crispy Potato Skins...
            </div>
          </div>

          <h3 class="text-lg font-bold text-white">Find something useful</h3>
          <p class="text-xs text-[#8E9196] leading-relaxed">
            A recipe, gym routine, travel guide, or craft tutorial. Tap the standard Share icon you already use every day.
          </p>
        </div>
        <div class="text-[11px] font-mono text-[#6B7280] pt-4 border-t border-white/[0.06]">
          Works across major video feeds
        </div>
      </div>

      <!-- Step 2 -->
      <div class="specular-box p-6 rounded-2xl flex flex-col justify-between border-[#FF2D55]/30">
        <div class="space-y-4">
          <div class="flex items-center justify-between text-xs font-mono">
            <span class="text-[#10B981] font-bold">02 · TAP STASH</span>
            <span class="text-[#10B981]">1 TAP</span>
          </div>

          <!-- Authentic System Share Sheet Preview Card -->
          <div class="w-full aspect-[16/10] rounded-xl bg-[#0D1017] border border-[#FF2D55]/30 overflow-hidden relative p-3 flex flex-col justify-between">
            <div class="flex items-center justify-between text-[9px] font-mono uppercase text-[#8E9196] border-b border-white/[0.06] pb-1.5">
              <span>System Share Sheet</span>
              <span class="text-[#10B981]">1-Tap Direct</span>
            </div>
            
            <div class="grid grid-cols-4 gap-2 text-center text-[9px]">
              <div class="flex flex-col items-center gap-1 opacity-35">
                <div class="w-8 h-8 rounded-xl bg-white/10 flex items-center justify-center">
                  <svg class="w-3.5 h-3.5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" /></svg>
                </div>
                <span>Messages</span>
              </div>
              <div class="flex flex-col items-center gap-1 opacity-35">
                <div class="w-8 h-8 rounded-xl bg-white/10 flex items-center justify-center">
                  <svg class="w-3.5 h-3.5 text-[#25D366]" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/></svg>
                </div>
                <span>WhatsApp</span>
              </div>
              <!-- STASH ACTIVE TARGET -->
              <div class="flex flex-col items-center gap-1 scale-105">
                <div class="w-8 h-8 rounded-xl bg-[#FF2D55] border border-white/40 flex items-center justify-center text-white shadow-lg shadow-[#FF2D55]/50 ring-2 ring-[#FF2D55]/50">
                  <img src="/assets/icon-512.png" alt="STASH" width="20" height="20" style="width: 20px; height: 20px; object-fit: contain;" class="w-5 h-5 rounded-md" />
                </div>
                <span class="text-white font-bold text-[9px]">STASH</span>
              </div>
              <div class="flex flex-col items-center gap-1 opacity-35">
                <div class="w-8 h-8 rounded-xl bg-white/10 flex items-center justify-center">
                  <svg class="w-3.5 h-3.5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" /></svg>
                </div>
                <span>Copy Link</span>
              </div>
            </div>

            <div class="p-1 rounded bg-[#10B981]/10 border border-[#10B981]/20 text-[9px] font-mono text-center text-[#10B981]">
              ✦ Captured in 0.3s — Never lose the link
            </div>
          </div>

          <h3 class="text-lg font-bold text-white">Select STASH in your Share Sheet</h3>
          <p class="text-xs text-[#8E9196] leading-relaxed">
            STASH appears directly in your system share options. One tap saves the clip, creator notes, and full video.
          </p>
        </div>
        <div class="text-[11px] font-mono text-[#10B981] pt-4 border-t border-white/[0.06]">
          ✓ Keeps you watching without interruption
        </div>
      </div>

      <!-- Step 3 -->
      <div class="specular-box p-6 rounded-2xl flex flex-col justify-between">
        <div class="space-y-4">
          <div class="flex items-center justify-between text-xs font-mono">
            <span class="text-white font-bold">03 · SECURED</span>
            <span class="text-[#8E9196]">FOR REAL LIFE</span>
          </div>

          <!-- Authentic Structured Vault Preview Card -->
          <div class="w-full aspect-[16/10] rounded-xl bg-[#090B0E] border border-white/10 overflow-hidden relative p-3 flex flex-col justify-between">
            <div class="flex items-center justify-between text-[9px] font-mono pb-1 border-b border-white/[0.06]">
              <span class="text-[#10B981] font-bold flex items-center gap-1">
                <span class="w-1.5 h-1.5 rounded-full bg-[#10B981]"></span>
                VAULT SECURED
              </span>
              <span class="text-[#8E9196]">COOK MODE</span>
            </div>

            <div class="space-y-1.5 my-1">
              <div class="flex items-center gap-2 px-2 py-1 rounded bg-white/[0.03] border border-white/[0.05] text-[10px] text-white/90">
                <span class="w-3 h-3 rounded bg-[#10B981] text-black font-bold flex items-center justify-center text-[8px]">✓</span>
                <span class="truncate">4 Russet potatoes (scrubbed)</span>
              </div>
              <div class="flex items-center gap-2 px-2 py-1 rounded bg-white/[0.03] border border-white/[0.05] text-[10px] text-white/90">
                <span class="w-3 h-3 rounded bg-[#10B981] text-black font-bold flex items-center justify-center text-[8px]">✓</span>
                <span class="truncate">2 tbsp melted garlic butter</span>
              </div>
            </div>

            <div class="flex items-center justify-between text-[9px] font-mono text-[#8E9196] pt-1 border-t border-white/[0.06]">
              <span>Official Player Docked</span>
              <span class="text-white">Offline Ready</span>
            </div>
          </div>

          <h3 class="text-lg font-bold text-white">Ready when you need it</h3>
          <p class="text-xs text-[#8E9196] leading-relaxed">
            The video, creator credit, exact source caption, and structured steps are organized in your private vault.
          </p>
        </div>
        <div class="text-[11px] font-mono text-[#6B7280] pt-4 border-t border-white/[0.06]">
          Offline checklists & private collections
        </div>
      </div>

    </div>

  </div>
</section>
