---
// Section 8: CONVERT — Closing Conversion Dock & Download Handoff
---

<section id="download" class="relative py-28 px-4 sm:px-6 lg:px-8 border-t border-borderSpecular/40 overflow-hidden bg-gradient-to-b from-obsidian via-surface/40 to-obsidian">
  <!-- Glowing background elements -->
  <div class="pointer-events-none absolute -bottom-24 left-1/2 -translate-x-1/2 w-[700px] h-[350px] bg-crimson/15 rounded-full blur-[160px]"></div>

  <div class="max-w-7xl mx-auto relative z-10">
    <div class="bg-monolith/80 border border-borderSpecular rounded-3xl p-8 sm:p-14 backdrop-blur-2xl shadow-2xl relative overflow-hidden">
      
      <!-- Top Decorative Accent -->
      <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-transparent via-crimson to-transparent"></div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <!-- LEFT: Closing Pitch & CTAs (7 cols) -->
        <div class="lg:col-span-7">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-crimson/10 border border-crimson/20 text-crimson text-xs font-mono tracking-widest uppercase mb-6">
            <span class="w-2 h-2 rounded-full bg-crimson animate-ping"></span>
            STASH VERSION 2.0 IS LIVE ON GOOGLE PLAY
          </div>

          <h2 class="text-3xl sm:text-5xl font-black tracking-tight text-white leading-tight">
            The internet has a Save button.<br />
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-white via-neutral-200 to-neutral-400">STASH is what happens next.</span>
          </h2>

          <p class="mt-5 text-base sm:text-lg text-neutral-300 font-light leading-relaxed max-w-xl">
            Your best finds shouldn't disappear into the scroll. Save in 1 tap from Instagram, TikTok, and YouTube.
          </p>

          <!-- Primary & Secondary Harmonious Dual CTA Block -->
          <div class="mt-8 flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
            
            <!-- Direct Google Play Link (Primary Solid White) -->
            <a 
              href="https://play.google.com/store/apps/details?id=com.stash.mediavault" 
              target="_blank" 
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-3.5 px-6 py-4 rounded-2xl bg-white hover:bg-neutral-100 active:scale-[0.98] text-[#050608] font-bold text-sm transition-all duration-200 shadow-xl shadow-white/10 group flex-1 sm:flex-initial"
            >
              <svg class="w-6 h-6 text-[#050608] shrink-0" viewBox="0 0 24 24" fill="currentColor">
                <path d="M3.609 1.814L13.792 12 3.61 22.186a2.036 2.036 0 0 1-.22-.916V2.73c0-.337.078-.654.22-.916zm11.246 11.248l2.36 2.36-12.06 6.843 9.7-9.203zm0-2.124L5.155 1.735 17.215 8.58l-2.36 2.358zm1.464 1.463l3.662-2.079a1.69 1.69 0 0 0 0-2.923L16.32 7.32l2.122 2.122-2.123 2.959z"/>
              </svg>
              <div class="text-left">
                <div class="text-[10px] uppercase font-mono tracking-wider text-neutral-600 leading-none">Get it on</div>
                <div class="text-base font-black leading-tight text-[#050608]">Google Play</div>
              </div>
            </a>

            <!-- Matching Apple iOS / iPhone Badge (Refined Frosted Glass) -->
            <div 
              class="inline-flex items-center justify-center gap-3.5 px-6 py-4 rounded-2xl bg-white/[0.05] border border-white/10 text-white text-sm transition-all duration-200 flex-1 sm:flex-initial cursor-default"
            >
              <svg class="w-6 h-6 text-white shrink-0 opacity-90" viewBox="0 0 24 24" fill="currentColor">
                <path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M15.97 6.37c.61-.75 1.04-1.8 0.92-2.87-.92.04-2.02.62-2.67 1.37-.58.65-1.09 1.73-.95 2.76 1.03.08 2.09-.53 2.7-1.26z"/>
              </svg>
              <div class="text-left">
                <div class="text-[10px] uppercase font-mono tracking-wider text-neutral-400 leading-none">Apple iOS / iPhone</div>
                <div class="text-base font-bold leading-tight text-white/90 flex items-center gap-2">
                  <span>Coming Soon</span>
                  <span class="text-[9px] font-mono px-1.5 py-0.5 rounded bg-emerald-500/20 text-emerald-400 border border-emerald-500/30">Beta Soon</span>
                </div>
              </div>
            </div>

          </div>

          <!-- Trust Badges -->
          <div class="mt-8 pt-6 border-t border-white/5 flex flex-wrap items-center gap-6 text-xs text-neutral-400 font-mono">
            <span class="flex items-center gap-1.5">
              <svg class="w-4 h-4 text-emerald" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              Official In-App Playback
            </span>
            <span class="flex items-center gap-1.5">
              <svg class="w-4 h-4 text-emerald" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              Zero Feed Ads
            </span>
            <span class="flex items-center gap-1.5">
              <svg class="w-4 h-4 text-emerald" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              Hardware Biometrics
            </span>
          </div>

        </div>

        <!-- RIGHT: Desktop-to-Phone QR Code Transfer Dock (5 cols) -->
        <div class="lg:col-span-5 flex flex-col items-center justify-center p-7 bg-white/[0.02] rounded-3xl border border-white/10 text-center relative overflow-hidden">
          
          <div class="text-sm font-bold text-white mb-1">Instant Mobile Install</div>
          <p class="text-xs text-neutral-400 max-w-xs mb-5 leading-relaxed">
            Scan with your phone's camera to open the STASH listing directly on Google Play.
          </p>

          <!-- Stylized QR Code Component with Clean Frame -->
          <div class="relative p-3.5 bg-white rounded-2xl shadow-2xl inline-block group border border-white/20">
            <!-- Dynamically generated clean QR pointing to Play Store -->
            <img 
              src="https://api.qrserver.com/v1/create-qr-code/?size=180x180&data=https%3A%2F%2Fplay.google.com%2Fstore%2Fapps%2Fdetails%3Fid%3Dcom.stash.mediavault&bgcolor=ffffff&color=050507&margin=0" 
              alt="Scan QR code to install STASH from Google Play Store" 
              width="144" 
              height="144" 
              class="w-36 h-36 rounded-lg object-contain"
              loading="lazy"
            />
          </div>

          <div class="mt-4 flex items-center gap-2 text-[11px] font-mono text-[#10B981]">
            <span class="w-1.5 h-1.5 rounded-full bg-[#10B981]"></span>
            <span>Official Google Play Release · Free Download</span>
          </div>
        </div>

      </div>

    </div>
  </div>
</section>
