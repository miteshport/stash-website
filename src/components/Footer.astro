---
// STASH Website 2.0 Footer Component
const currentYear = new Date().getFullYear();
---

<footer class="relative border-t border-borderSpecular/40 bg-monolith/90 text-neutral-400 py-16 px-4 sm:px-6 lg:px-8">
  <div class="max-w-7xl mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-10 mb-12">
      
      <!-- Brand & Mission Column -->
      <div class="md:col-span-2 space-y-4">
        <a href="/" class="flex items-center gap-3 text-white group">
          <img src="/assets/icon-512.png" alt="STASH Logo" width="32" height="32" style="width: 32px; height: 32px; object-fit: contain;" class="w-8 h-8 rounded-xl shadow-[0_2px_12px_rgba(255,45,85,0.4)] border border-white/10 group-hover:scale-105 transition-transform flex-shrink-0" />
          <span class="font-extrabold tracking-tight text-xl text-white">STASH</span>
        </a>
        <p class="text-xs text-neutral-400 max-w-sm leading-relaxed">
          The Personal Action Vault for mobile discovery. Turning saved recipes, workouts, travel guides, and tutorials into real-world action.
        </p>
        <p class="text-[11px] font-mono text-neutral-500">
          "The internet has a Save button. STASH is what happens next."
        </p>
      </div>

      <!-- Product Navigation -->
      <div>
        <h4 class="text-xs font-mono uppercase tracking-widest text-white mb-4">Navigation</h4>
        <ul class="space-y-2.5 text-xs">
          <li><a href="#simulator" class="hover:text-white transition-colors">How It Works</a></li>
          <li><a href="#problem" class="hover:text-white transition-colors">Why STASH</a></li>
          <li><a href="#action-engine" class="hover:text-white transition-colors">Action Tools</a></li>
          <li><a href="#breadth" class="hover:text-white transition-colors">Categories</a></li>
          <li><a href="#privacy-vault" class="hover:text-white transition-colors">Privacy Vault</a></li>
          <li><a href="#source-notes" class="hover:text-white transition-colors">Source Notes</a></li>
          <li><a href="#download" class="hover:text-white transition-colors">Get STASH</a></li>
        </ul>
      </div>

      <!-- Compliance & Legal -->
      <div>
        <h4 class="text-xs font-mono uppercase tracking-widest text-white mb-4">Legal & Trust</h4>
        <ul class="space-y-2.5 text-xs">
          <li><a href="/privacy.html" class="hover:text-white transition-colors">Privacy Policy</a></li>
          <li><a href="/terms.html" class="hover:text-white transition-colors">Terms of Service</a></li>
          <li><a href="/data-deletion.html" class="hover:text-white transition-colors">User Data Deletion</a></li>
          <li><a href="mailto:support@stashvault.app" class="hover:text-white transition-colors">Support & Feedback</a></li>
        </ul>
        <div class="mt-6 pt-4 border-t border-white/5 text-[11px] font-mono text-neutral-400">
          <div>Secured on your device</div>
          <div>100% private by default</div>
        </div>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 border-t border-white/5 flex flex-col sm:flex-row items-center justify-between gap-4 text-[11px] font-mono text-neutral-400">
      <div>
        © {currentYear} STASH (Media Vault). All rights reserved.
      </div>
      <div class="flex items-center gap-4">
        <span>No feed algorithms</span>
        <span>•</span>
        <span>No sponsored ads</span>
        <span>•</span>
        <span>Pure utility</span>
      </div>
    </div>
  </div>
</footer>
