---
// Section 7: SOURCE — Honest Intelligence
---

<section id="source-notes" class="relative py-28 px-4 sm:px-6 lg:px-8 border-t border-borderSpecular/40 overflow-hidden bg-obsidian">
  <!-- Subtle ambient glow -->
  <div class="pointer-events-none absolute top-1/3 left-1/4 w-96 h-96 bg-crimson/5 rounded-full blur-[140px]"></div>

  <div class="max-w-7xl mx-auto">
    <!-- Section Header -->
    <div class="max-w-3xl mb-16 text-left">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-crimson/10 border border-crimson/20 text-crimson text-xs font-mono tracking-widest uppercase mb-4">
        <svg class="w-3.5 h-3.5 text-crimson" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        HONEST INTELLIGENCE
      </div>
      <h2 class="text-3xl sm:text-5xl font-black tracking-tight text-white leading-tight">
        When STASH doesn’t know,<br class="hidden sm:block" />it doesn’t pretend.
      </h2>
      <p class="mt-4 text-base sm:text-xl text-neutral-400 font-light leading-relaxed">
        Generic AI tools fabricate missing ingredients and guess oven temperatures when a creator mumbles. STASH preserves what was actually said, cleans up the formatting, and never invents facts.
      </p>
    </div>

    <!-- Comparative Grid & Interactive Clipboard Sandbox -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      
      <!-- LEFT: Comparison (5 Cols) -->
      <div class="lg:col-span-5 flex flex-col gap-6 text-left">
        
        <!-- Generic AI Card -->
        <div class="bg-monolith/60 border border-red-500/20 rounded-2xl p-6 relative overflow-hidden">
          <div class="flex items-center justify-between mb-4">
            <span class="text-xs font-mono uppercase text-red-400 tracking-wider flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5 text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
              </svg>
              Generic Recipe Summarizers
            </span>
            <span class="text-[10px] bg-red-500/10 text-red-400 px-2 py-0.5 rounded border border-red-500/20">Hallucinated Data</span>
          </div>

          <div class="space-y-3 text-xs text-neutral-400 font-sans">
            <div class="p-3 rounded-lg bg-surface/50 border border-white/5">
              <span class="text-red-300 font-mono">Bake at 375°F for 40 mins</span>
              <p class="text-[11px] text-neutral-400 mt-1">Creator never gave a temp. The model filled in a standard default. Your roast burns.</p>
            </div>
            <div class="p-3 rounded-lg bg-surface/50 border border-white/5">
              <span class="text-red-300 font-mono">Add 2 tbsp heavy cream</span>
              <p class="text-[11px] text-neutral-400 mt-1">Creator cooked dairy-free coconut milk. Generic model guessed wrong.</p>
            </div>
          </div>
        </div>

        <!-- STASH Clean Source Notes Card -->
        <div class="bg-monolith/80 border border-emerald/30 rounded-2xl p-6 relative overflow-hidden">
          <div class="flex items-center justify-between mb-4">
            <span class="text-xs font-mono uppercase text-emerald tracking-wider flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5 text-emerald" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
              </svg>
              STASH Source Fidelity
            </span>
            <span class="text-[10px] bg-emerald/10 text-emerald px-2 py-0.5 rounded border border-emerald/30">Honest Extraction</span>
          </div>

          <div class="space-y-3 text-xs text-neutral-300 font-sans">
            <div class="p-3 rounded-lg bg-surface/80 border border-emerald/20">
              <span class="text-white font-medium">Verbatim Creator Notes</span>
              <p class="text-[11px] text-neutral-400 mt-1">If the creator says "cook until fork-tender without high heat," STASH quotes that directly rather than inventing a number.</p>
            </div>
            <div class="p-3 rounded-lg bg-surface/80 border border-emerald/20">
              <span class="text-white font-medium">Synced to Video Timestamps</span>
              <p class="text-[11px] text-neutral-400 mt-1">Steps are linked to the video timestamps so you can cross-check visually in one tap.</p>
            </div>
          </div>
        </div>

        <div class="p-4 rounded-xl bg-surface/30 border border-white/5 text-xs text-neutral-400 leading-relaxed">
          <strong class="text-white">Honest AI Principle:</strong> If a creator left out the salt measurement, STASH marks it <code class="text-amber bg-amber/10 px-1 py-0.5 rounded">[To Taste / Unspecified]</code>. We respect your kitchen and your time.
        </div>
      </div>

      <!-- RIGHT: Clean Source Notes Viewer (7 Cols) -->
      <div class="lg:col-span-7 bg-monolith/90 border border-borderSpecular rounded-3xl p-6 sm:p-8 backdrop-blur-xl relative shadow-2xl text-left">
        <div class="flex flex-wrap items-center justify-between gap-3 mb-6 pb-5 border-b border-white/5">
          <div>
            <div class="text-xs font-mono text-emerald tracking-wider uppercase font-semibold">Clean Source Notes</div>
            <div class="text-sm font-bold text-white">Crispy Smashed Fingerling Potatoes</div>
          </div>

          <!-- Interactive Copy Button -->
          <button 
            id="btn-copy-notes" 
            class="px-4 py-2 rounded-xl bg-crimson hover:bg-crimson/90 active:scale-95 text-white font-medium text-xs transition-all duration-200 flex items-center gap-2 shadow-lg shadow-crimson/20"
            aria-label="Copy extracted notes to clipboard"
          >
            <svg id="copy-icon-svg" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" />
            </svg>
            <span id="copy-btn-text">Copy Clean Notes</span>
          </button>
        </div>

        <!-- Clean Formatted Source Notes Reader Card -->
        <div class="relative bg-[#07080B] rounded-2xl p-5 sm:p-6 border border-white/10 text-neutral-300 shadow-inner">
          <div class="flex items-center justify-between text-[11px] text-neutral-400 border-b border-white/5 pb-3 mb-5">
            <div class="flex items-center gap-2">
              <span class="w-2 h-2 rounded-full bg-[#10B981]"></span>
              <span class="text-white font-medium">Instagram Reel (@chef_danilo)</span>
            </div>
            <span class="text-emerald font-mono text-[10px] uppercase tracking-wider bg-emerald/10 px-2 py-0.5 rounded border border-emerald/20">Preserved Verbatim</span>
          </div>

          <!-- Document Title & Provenance -->
          <div class="mb-5">
            <h4 class="text-base sm:text-lg font-bold text-white tracking-tight">Crispy Smashed Fingerling Potatoes & Herb Aioli</h4>
            <div class="text-[11px] font-mono text-neutral-400 mt-0.5">Exact creator transcription · Zero AI hallucination</div>
          </div>

          <!-- Section: Ingredients List -->
          <div class="mb-6 space-y-2.5">
            <div class="text-[11px] font-mono uppercase tracking-wider text-emerald font-bold flex items-center gap-1.5">
              <span>✦</span>
              <span>Ingredients (9 Items)</span>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs">
              <div class="flex items-center gap-2 p-2 rounded-lg bg-white/[0.03] border border-white/[0.05]">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald"></span>
                <span>1.5 lbs Fingerling Potatoes</span>
              </div>
              <div class="flex items-center gap-2 p-2 rounded-lg bg-white/[0.03] border border-white/[0.05]">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald"></span>
                <span>3 tbsp Extra Virgin Olive Oil</span>
              </div>
              <div class="flex items-center gap-2 p-2 rounded-lg bg-white/[0.03] border border-white/[0.05]">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald"></span>
                <span>1.5 tsp Flaky Sea Salt</span>
              </div>
              <div class="flex items-center gap-2 p-2 rounded-lg bg-white/[0.03] border border-white/[0.05]">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald"></span>
                <span>1 tsp Fresh Rosemary (finely minced)</span>
              </div>
              <div class="flex items-center gap-2 p-2 rounded-lg bg-white/[0.03] border border-white/[0.05]">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald"></span>
                <span>1 tsp Fresh Thyme leaves</span>
              </div>
              <div class="flex items-center gap-2 p-2 rounded-lg bg-white/[0.03] border border-white/[0.05]">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald"></span>
                <span>1/2 tsp Smoked Paprika</span>
              </div>
              <div class="flex items-center gap-2 p-2 rounded-lg bg-white/[0.03] border border-white/[0.05]">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald"></span>
                <span>1/2 cup Greek Yogurt / Kewpie Mayo</span>
              </div>
              <div class="flex items-center gap-2 p-2 rounded-lg bg-white/[0.03] border border-white/[0.05]">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald"></span>
                <span>1 clove Garlic (grated) + lemon zest</span>
              </div>
            </div>
          </div>

          <!-- Section: Prep & Cook Steps with Synced Timestamp Chips -->
          <div class="space-y-2.5">
            <div class="text-[11px] font-mono uppercase tracking-wider text-white/80 font-bold flex items-center gap-1.5">
              <span>✦</span>
              <span>Steps · Synced to Video</span>
            </div>
            <div class="space-y-2 text-xs text-neutral-300">
              <div class="flex items-start gap-2.5 p-2 rounded-lg bg-white/[0.02] border border-white/[0.04]">
                <span class="font-mono text-[10px] text-emerald bg-emerald/10 border border-emerald/20 px-1.5 py-0.5 rounded shrink-0">0:04</span>
                <span>Parboil potatoes in salted water for 15-18 mins until pierced easily.</span>
              </div>
              <div class="flex items-start gap-2.5 p-2 rounded-lg bg-white/[0.02] border border-white/[0.04]">
                <span class="font-mono text-[10px] text-emerald bg-emerald/10 border border-emerald/20 px-1.5 py-0.5 rounded shrink-0">0:12</span>
                <span>Steam-dry for 5 minutes on clean towel to remove exterior moisture.</span>
              </div>
              <div class="flex items-start gap-2.5 p-2 rounded-lg bg-white/[0.02] border border-white/[0.04]">
                <span class="font-mono text-[10px] text-emerald bg-emerald/10 border border-emerald/20 px-1.5 py-0.5 rounded shrink-0">0:18</span>
                <span>Crush gently using flat bottom of drinking glass until cracked.</span>
              </div>
              <div class="flex items-start gap-2.5 p-2 rounded-lg bg-white/[0.02] border border-white/[0.04]">
                <span class="font-mono text-[10px] text-emerald bg-emerald/10 border border-emerald/20 px-1.5 py-0.5 rounded shrink-0">0:24</span>
                <span>Drizzle olive oil over parchment sheet and season generously.</span>
              </div>
              <div class="flex items-start gap-2.5 p-2 rounded-lg bg-white/[0.02] border border-white/[0.04]">
                <span class="font-mono text-[10px] text-emerald bg-emerald/10 border border-emerald/20 px-1.5 py-0.5 rounded shrink-0">0:36</span>
                <span>Roast at 425°F (220°C) for 22-25 mins until golden and crisp.</span>
              </div>
              <div class="flex items-start gap-2.5 p-2 rounded-lg bg-white/[0.02] border border-white/[0.04]">
                <span class="font-mono text-[10px] text-emerald bg-emerald/10 border border-emerald/20 px-1.5 py-0.5 rounded shrink-0">0:40</span>
                <span>Whisk aioli base, garlic, and lemon zest. Serve hot.</span>
              </div>
            </div>
          </div>

          <!-- Hidden Raw Text for Clipboard Copy -->
          <textarea id="raw-source-notes-code" class="hidden" readonly aria-hidden="true"># Crispy Smashed Fingerling Potatoes & Herb Aioli
Source: Instagram Reel (@chef_danilo)

## Ingredients
- 1.5 lbs Fingerling Potatoes
- 3 tbsp Extra Virgin Olive Oil
- 1.5 tsp Flaky Sea Salt
- 1 tsp Fresh Rosemary (finely minced)
- 1 tsp Fresh Thyme leaves
- 1/2 tsp Smoked Paprika
- 1/2 cup Greek Yogurt or Kewpie Mayo
- 1 clove Garlic (grated)
- 1 tsp Lemon juice + zest of 1/2 lemon

## Steps
[0:04] 1. Parboil potatoes in salted water for 15-18 mins until pierced easily.
[0:12] 2. Steam-dry for 5 minutes on clean towel to remove exterior moisture.
[0:18] 3. Crush gently using flat bottom of drinking glass until cracked.
[0:24] 4. Drizzle olive oil over parchment sheet.
[0:30] 5. Season with rosemary, thyme, salt, and paprika.
[0:36] 6. Roast at 425°F (220°C) for 22-25 mins until golden and crisp.
[0:40] 7. Whisk aioli base, garlic, and lemon zest. Serve hot.</textarea>
        </div>

        <!-- Real Product Screenshot Peek -->
        <div class="mt-6 flex flex-col sm:flex-row items-center gap-4 bg-surface/40 p-4 rounded-2xl border border-white/5">
          <div class="w-14 h-14 rounded-xl overflow-hidden shrink-0 border border-white/10 bg-obsidian">
            <img 
              src="/assets/ui/stash_ui_v3_potato_ingredients.jpg" 
              alt="STASH UI ingredients view" 
              class="w-full h-full object-cover"
              loading="lazy"
            />
          </div>
          <div class="text-xs text-neutral-400">
            <span class="text-white font-medium">Export anywhere:</span> Paste into Apple Notes, Obsidian, Notion, or your grocery list in 1 tap.
          </div>
        </div>

      </div>

    </div>
  </div>
</section>

<!-- Interactive Script for Copy Sandbox -->
<script is:inline>
  (function initSourceNotesSandbox() {
    const btnCopy = document.getElementById('btn-copy-notes');
    const copyText = document.getElementById('copy-btn-text');
    const copyIcon = document.getElementById('copy-icon-svg');
    const preCode = document.getElementById('raw-source-notes-code');

    if (!btnCopy || !preCode) return;

    btnCopy.addEventListener('click', async () => {
      try {
        const textToCopy = preCode.value || preCode.innerText || preCode.textContent;
        await navigator.clipboard.writeText(textToCopy);

        copyText.textContent = "Copied to Clipboard!";
        btnCopy.classList.remove('bg-crimson', 'hover:bg-crimson/90');
        btnCopy.classList.add('bg-emerald', 'hover:bg-emerald/90');
        copyIcon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />';

        setTimeout(() => {
          copyText.textContent = "Copy Clean Notes";
          btnCopy.classList.remove('bg-emerald', 'hover:bg-emerald/90');
          btnCopy.classList.add('bg-crimson', 'hover:bg-crimson/90');
          copyIcon.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" />';
        }, 3000);
      } catch (err) {
        copyText.textContent = "Select & Copy manually";
        setTimeout(() => {
          copyText.textContent = "Copy Clean Notes";
        }, 2500);
      }
    });
  })();
</script>
